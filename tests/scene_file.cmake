set(work "${CMAKE_CURRENT_BINARY_DIR}/Testing/scene_file")
file(MAKE_DIRECTORY "${work}/scene" "${work}/assets")
configure_file("${PROJECT_DIR}/scene/forest.json" "${work}/scene/forest.json" COPYONLY)
foreach(asset rock.obj rock.ppm)
  configure_file("${PROJECT_DIR}/assets/${asset}" "${work}/assets/${asset}" COPYONLY)
endforeach()
file(REMOVE "${work}/path.ppm")

execute_process(COMMAND "${TRACER}" --scene forest.json WORKING_DIRECTORY "${work}"
  RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT status STREQUAL "0" OR NOT log MATCHES "Loaded scene/forest.json \\(primitives=8, materials=1\\)[\r\n]+Prepared RenderScene and Film \\(256x256\\)[\r\n]+Rendered 65536 pixels \\(64 samples/pixel, threads=1\\)[\r\n]+render_seconds=[0-9]+[.][0-9]+[\r\n]+Wrote path.ppm")
  message(FATAL_ERROR "Scene render failed: ${log}${error}")
endif()

file(STRINGS "${work}/path.ppm" lines)
list(SUBLIST lines 0 3 header)
list(LENGTH lines count)
if(NOT header STREQUAL "P3;256 256;255" OR NOT count EQUAL 65539)
  message(FATAL_ERROR "Unexpected PPM header or pixel count: ${header}, ${count} total lines")
endif()

file(SHA256 "${work}/path.ppm" single_thread_hash)
file(REMOVE "${work}/path.ppm")
execute_process(COMMAND "${TRACER}" --threads 4 --scene forest.json WORKING_DIRECTORY "${work}"
  RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT status STREQUAL "0" OR NOT log MATCHES "threads=4\\)")
  message(FATAL_ERROR "Multi-threaded scene render failed: ${log}${error}")
endif()
file(SHA256 "${work}/path.ppm" multi_thread_hash)
if(NOT multi_thread_hash STREQUAL single_thread_hash)
  message(FATAL_ERROR "Changing --threads changed the image")
endif()

foreach(invalid IN ITEMS 0 -1 257 1.5 4x)
  execute_process(COMMAND "${TRACER}" --scene forest.json --threads "${invalid}" WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(status STREQUAL "0" OR NOT error MATCHES "Usage:")
    message(FATAL_ERROR "Expected invalid --threads ${invalid} to fail during argument parsing")
  endif()
endforeach()

# Write a small scene with a film block, keeping forest.json as the legacy case.
file(READ "${work}/scene/forest.json" forest)
function(set_film fields)
  string(REGEX REPLACE "^[{]" "{\"film\":{${fields}}," configured "${forest}")
  file(WRITE "${work}/scene/sized.json" "${configured}")
endfunction()

function(check_film width height spp)
  file(REMOVE "${work}/path.ppm")
  execute_process(COMMAND "${TRACER}" --scene sized.json ${ARGN} WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE error)
  if(NOT status STREQUAL "0" OR NOT log MATCHES "\\(${spp} samples/pixel,")
    message(FATAL_ERROR "Film render failed: ${log}${error}")
  endif()
  file(STRINGS "${work}/path.ppm" header LIMIT_COUNT 3)
  if(NOT header STREQUAL "P3;${width} ${height};255")
    message(FATAL_ERROR "Unexpected film size: ${header}")
  endif()
endfunction()

set_film("\"width\":19,\"height\":11")
check_film(19 11 64)
check_film(7 11 2 --width 7 --spp 2)
check_film(19 5 1 --height 5 --spp 1)
check_film(23 9 3 --width 23 --height 9 --spp 3)
foreach(split IN ITEMS median sah)
  check_film(23 9 3 --width 23 --height 9 --spp 3 --bvh ${split})
  file(SHA256 "${work}/path.ppm" ${split}_hash)
endforeach()
if(NOT median_hash STREQUAL sah_hash)
  message(FATAL_ERROR "Changing --bvh changed the rock image")
endif()
set_film("\"width\":8")
check_film(8 256 1 --spp 1)

foreach(value IN ITEMS 0 -2 2.5 16385 "\"3\"" true 18446744073709551615)
  set_film("\"width\":${value}")
  execute_process(COMMAND "${TRACER}" --scene sized.json WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(status STREQUAL "0" OR NOT error MATCHES "film[.]width")
    message(FATAL_ERROR "Expected invalid width ${value} to fail during scene loading")
  endif()
endforeach()

foreach(args IN ITEMS "--width;0" "--height;16385" "--spp;-1" "--spp;1.5" "--spp;2147483648" "--width;1;--width;2"
    "--bvh;unknown" "--bvh;median;--bvh;sah" "--bvh"
    "--mode;unknown" "--mode;nee;--mode;mis" "--mode")
  execute_process(COMMAND "${TRACER}" --scene forest.json ${args} WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(status STREQUAL "0" OR NOT error MATCHES "Usage:")
    message(FATAL_ERROR "Expected invalid arguments to fail: ${args}")
  endif()
endforeach()

configure_file("${PROJECT_DIR}/assets/studio-hdr.pfm" "${work}/assets/studio-hdr.pfm" COPYONLY)
set(env_fields [=["type":"environment","map":"../assets/studio-hdr.pfm"]=])
function(check_environment lights expected_error)
  file(WRITE "${work}/scene/environment.json"
    "{\"camera\":{\"position\":[0,0,0],\"target\":[-0.403,0.796,0.451],\"fov_degrees\":1},\"materials\":{},\"objects\":[],\"lights\":[${lights}]}")
  file(REMOVE "${work}/path.ppm")
  execute_process(COMMAND "${TRACER}" --scene environment.json --width 2 --height 2 --spp 1
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_QUIET)
  if(expected_error STREQUAL "")
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "Expected valid environment: ${error}")
    endif()
  elseif(status STREQUAL "0" OR NOT error MATCHES "${expected_error}")
    message(FATAL_ERROR "Expected environment error matching '${expected_error}', got '${error}'")
  endif()
endfunction()
check_environment("{${env_fields}}" "")
file(SHA256 "${work}/path.ppm" default_env_hash)
check_environment("{${env_fields},\"rotation_degrees\":360,\"intensity\":1}" "")
file(SHA256 "${work}/path.ppm" full_turn_hash)
if(NOT full_turn_hash STREQUAL default_env_hash)
  message(FATAL_ERROR "Environment defaults differ from a full turn at unit intensity")
endif()
check_environment("{${env_fields},\"intensity\":0}" "")
file(STRINGS "${work}/path.ppm" black_pixels REGEX "^0 0 0$")
list(LENGTH black_pixels black_count)
if(NOT black_count EQUAL 4)
  message(FATAL_ERROR "Zero environment intensity must produce a black background")
endif()
check_environment("{${env_fields}},{${env_fields}}" "Only one environment")
check_environment("{${env_fields},\"intensity\":-0.5}" "environment[.]intensity")
check_environment("{${env_fields},\"rotation_degrees\":\"90\"}" "rotation_degrees")
check_environment([=[{"type":"environment"}]=] "map")
check_environment([=[{"type":"environment","map":"missing.pfm"}]=] "missing.pfm")

function(sampling_hash result)
  file(REMOVE "${work}/path.ppm")
  execute_process(COMMAND "${TRACER}" --scene "${PROJECT_DIR}/scene/mis_sampling.json"
    --width 32 --height 18 --spp 4 --bvh sah ${ARGN} WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_QUIET)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Sampling render failed: ${error}")
  endif()
  file(SHA256 "${work}/path.ppm" hash)
  set(${result} "${hash}" PARENT_SCOPE)
endfunction()
sampling_hash(default_hash)
foreach(mode IN ITEMS bsdf nee mis)
  sampling_hash(${mode}_hash --mode ${mode})
endforeach()
if(NOT default_hash STREQUAL nee_hash)
  message(FATAL_ERROR "Default sampling mode must match explicit NEE")
endif()
if(bsdf_hash STREQUAL nee_hash OR bsdf_hash STREQUAL mis_hash OR nee_hash STREQUAL mis_hash)
  message(FATAL_ERROR "The three modes must select distinct estimators on the MIS comparison scene")
endif()

# Height profiles must be explicit, complete and nonnegative. Exercise the CLI
# loader as well as the analytic/sampling tests in height_medium_tests.cpp.
function(check_height_medium fields expected_error)
  string(REGEX REPLACE "^[{]" "{\"medium\":${fields}," configured "${forest}")
  file(WRITE "${work}/scene/height.json" "${configured}")
  file(REMOVE "${work}/path.ppm")
  execute_process(COMMAND "${TRACER}" --scene height.json --width 1 --height 1 --spp 1
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_QUIET)
  if(expected_error STREQUAL "")
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "Valid height medium failed: ${error}")
    endif()
  elseif(status STREQUAL "0" OR NOT error MATCHES "${expected_error}")
    message(FATAL_ERROR "Expected medium error ${expected_error}: ${error}")
  endif()
endfunction()
set(height_fields [=["min":[-1,0,-1],"max":[1,4,1],"density":0.6,"albedo":0.8]=])
check_height_medium("{${height_fields},\"type\":\"height_linear\",\"density_top\":0}" "")
check_height_medium("{${height_fields},\"type\":\"height_linear\"}" "density_top")
check_height_medium("{${height_fields},\"type\":\"height_linear\",\"density_top\":-1}" "density_top")
check_height_medium("{${height_fields},\"type\":\"height_linear\",\"density_top\":true}" "density_top")
check_height_medium("{${height_fields},\"type\":\"homogeneous\",\"density_top\":0}" "density_top")
check_height_medium("{${height_fields},\"type\":\"unknown\"}" "Unknown medium type")
